# Firebase Web App config (Firebase Console → Project settings → Your apps → Web app).
# These values are public identifiers, not secrets: access is protected by firestore.rules.
VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000

# Local development without a real project: `npm run emulators` + these values.
# VITE_FIREBASE_PROJECT_ID=demo-hb-quiz
# VITE_FIREBASE_API_KEY=demo-key
# VITE_FIREBASE_AUTH_DOMAIN=demo-hb-quiz.firebaseapp.com
# VITE_FIREBASE_APP_ID=1:000000000000:web:demo
# VITE_USE_FIREBASE_EMULATORS=true

# Optional: change the host password. Value = lowercase SHA-256 hex of the new password,
# e.g. `printf '%s' 123456 | shasum -a 256`. If unset, the built-in default is used.
# VITE_HOST_PASSWORD_SHA256=
